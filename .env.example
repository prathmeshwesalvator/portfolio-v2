# Copy to `.env.local` (never commit real values) and fill in what you need.
# All variables are optional — the site builds and works without any of them.

# ---------------------------------------------------------------------------
# Production URL — used for canonical links, Open Graph images, robots.txt and
# the sitemap. Example: https://your-domain.com (no trailing slash).
# Without it, Vercel deployments use VERCEL_PROJECT_PRODUCTION_URL automatically;
# local builds fall back to http://localhost:3000.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Freelance inquiry form delivery (EmailJS) — optional.
#
# When ALL THREE values below are set, the inquiry form sends briefs straight
# to your inbox through the EmailJS REST API. Otherwise it falls back to a
# mailto: draft that opens in the visitor's own email app (nothing is sent
# automatically, and the UI says so).
#
# The EmailJS public key is designed to be public, but lock it down:
#   - EmailJS dashboard → Account → Security: restrict "Allowed origins" to
#     your production domain.
#   - Enable EmailJS's spam protection / rate limits for the template.
#
# Template variables the form sends:
#   {{name}} {{email}} {{reply_to}} {{subject}} {{message}} {{project_type}} {{budget}}
# ---------------------------------------------------------------------------
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
